{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-content-receipt.v1",
  "type": "object",
  "required": [
    "version",
    "taskId",
    "status",
    "claimReleased",
    "preparation",
    "save",
    "invocation",
    "content",
    "research",
    "handoff",
    "remainingClaims",
    "networkCalls"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "agent-content-receipt.v1"
    },
    "taskId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "claimed",
        "prepared",
        "blocked",
        "done"
      ]
    },
    "claimReleased": {
      "type": "boolean"
    },
    "preparation": {
      "type": [
        "object",
        "null"
      ]
    },
    "save": {
      "type": [
        "object",
        "null"
      ]
    },
    "invocation": {
      "type": [
        "object",
        "null"
      ]
    },
    "content": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "hashtags": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "title",
            "text",
            "hashtags"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "research": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "validUntil": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "sources": {
              "minItems": 2,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "accessedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                },
                "required": [
                  "url",
                  "title",
                  "accessedAt"
                ],
                "additionalProperties": false
              }
            },
            "uncertainty": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            }
          },
          "required": [
            "topic",
            "summary",
            "observedAt",
            "validUntil",
            "sources",
            "uncertainty"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "handoff": {
      "type": [
        "string",
        "null"
      ]
    },
    "remainingClaims": {
      "type": "integer",
      "minimum": 0
    },
    "networkCalls": {
      "const": 0
    }
  }
}
