# Social Command Center - Environment Variables
PORT=3001
NODE_ENV=development
TZ=Asia/Bangkok

# Local Storage
DATA_DIR=.data

# Upstream AI Video Pipeline Watched Directory
PIPELINE_WATCH_DIR=D:\Mamduh\Personal\ai-video-pipeline\.tmp-live-validation

# Meta Graph API (Optional - required only for live Facebook publishing)
META_APP_ID=
