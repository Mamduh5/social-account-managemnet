# TikTok Developer API (Optional - required only for live TikTok publishing)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional server-only path to an explicitly approved Free-tier text-provider configuration.
# Leave unset for unavailable/manual-only generation; never put provider keys in client code.
SCC_ASSISTANT_PROVIDER_CONFIG=
