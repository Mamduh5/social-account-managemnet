{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billowing-leaf-7ccd",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
