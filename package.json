{
  "name": "social-account-managemnet",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "start": "tsx scripts/owner-runtime.ts start",
    "test": "tsx test/run-tests.ts",
    "test:onboarding": "tsx test/e2e/real_account_onboarding.ts",
    "proxy:https": "tsx server/src/loopback-proxy.ts",
    "review:v110": "tsx scripts/run-v110-review.ts",
    "owner:start": "tsx scripts/owner-runtime.ts start",
    "owner:stop": "tsx scripts/owner-runtime.ts stop",
    "owner:status": "tsx scripts/owner-runtime.ts status",
    "owner:startup": "tsx scripts/owner-runtime.ts install-startup",
    "owner:disable": "tsx scripts/owner-runtime.ts disable",
    "owner:update": "tsx scripts/owner-update.ts",
    "owner:rollback": "tsx scripts/owner-update.ts --rollback"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mamduh5/social-account-managemnet.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mamduh5/social-account-managemnet/issues"
  },
  "homepage": "https://github.com/Mamduh5/social-account-managemnet#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
